        {
          "name": "Поиск товаров по категории",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Все товары соответствуют категории по запросу\", function () {\r",
                  "    // Получаем данные ответа\r",
                  "    const products = pm.response.json();\r",
                  "    \r",
                  "    // Получаем категорию из URL запроса\r",
                  "    const url = pm.request.url.toString();\r",
                  "    const categoryFromUrl = url.split('category=')[1].split('&')[0];\r",
                  "    const expectedCategory = decodeURIComponent(categoryFromUrl);\r",
                  "    \r",
                  "    // Проверяем каждый продукт в массиве\r",
                  "    products.forEach(product => {\r",
                  "        pm.expect(product.category).to.equal(expectedCategory);\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": ""
              }
            ],
