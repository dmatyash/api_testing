                  "pm.test(\"Вся продукция соответствует требованиям производителя по запросу\", function () {\r",
                  "    // Получаем данные ответа\r",
                  "    const responseData = pm.response.json();\r",
                  "    \r",
                  "    // Получаем производителя из URL запроса\r",
                  "    const url = pm.request.url.toString();\r",
                  "    const manufacturerFromUrl = url.split('manufacturer=')[1].split('&')[0];\r",
                  "    const expectedManufacturer = decodeURIComponent(manufacturerFromUrl);\r",
                  "    \r",
                  "    // Проверяем каждый продукт в массиве\r",
                  "    for (let i = 0; i < responseData.length; i++) {\r",
                  "        pm.expect(responseData[i].manufacturer).to.equal(expectedManufacturer);\r",
                  "    }\r",
                  "});"
